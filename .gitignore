node_modules/
.next/
out/
build/
dist/
coverage/
*.tsbuildinfo
next-env.d.ts
.vercel
.DS_Store
*.log

# 秘密の値が入るので .env.example 以外は commit しない
.env
.env.*
!.env.example

.claude/settings.local.json
CLAUDE.local.md

*.pem

# 推論の仮想環境・取得済みモデル・検証画像とBlenderのPythonキャッシュは共有しない
.venv/
__pycache__/
*.pyc
apps/inference/models/*
!apps/inference/models/.gitkeep
apps/inference/.cache/
# Rust拡張のビルド結果
apps/inference/native/target/
# 服ごとのテクスチャはPCで確かめるための出力で、服の写真を含むため共有しない
apps/inference/textures/
.tools/

# 作業用画像は共有しない。既存の追跡済みアイコン・デザイン資料は維持する
*.[pP][nN][gG]
*.[jJ][pP][gG]
*.[jJ][pP][eE][gG]
# アプリが出すプリセットのサムネイル（Blenderのrender_presets.pyが描く）は共有する
!apps/web/public/presets/**/thumbs/*.png

# Blenderの元モデル・作業ファイル・世代別バックアップはローカルに残す
*.[bB][lL][eE][nN][dD]
*.[bB][lL][eE][nN][dD][0-9]*
# 受領したモデルとUV展開図も元素材としてローカルに残す
artifacts/uv/pitari/inputs/**/*.glb
artifacts/uv/pitari/inputs/**/*.svg

# UVテンプレートの生成物・検証結果。scriptsとREADMEだけ共有する
artifacts/uv/pitari/uv_template.json
artifacts/uv/pitari/data/
artifacts/uv/pitari/masks/
artifacts/uv/pitari/check/
artifacts/uv/pitari/renders/
artifacts/uv/pitari/trials/
# ズボンのテンプレートも生成物。build_trousers_template.pyで作り直す
artifacts/uv/pitari/trousers/
# 長そでのテンプレートも受領モデルから再生成する
artifacts/uv/pitari/longsleeve/
# シャツのテンプレートも受領モデルから再生成する
artifacts/uv/pitari/shirt/
