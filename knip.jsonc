{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  // 同じファイルの中で使っているexportは見逃す。消すべきなのは、どこでも使っていないものだけ
  "ignoreExportsUsedInFile": true,
  // Claude Designが書き出した資料で、どこからも読み込まない
  "ignore": ["docs/design_handoff_app_shell/**"],
  // Supabase CLIは、npmではなく各自のPCに入れる（docs/setup.md）
  "ignoreBinaries": ["supabase"],
}
